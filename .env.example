# 运行配置（勿在前端展示密钥或模型名）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4-pro
DASHSCOPE_ENABLE_THINKING=false
DASHSCOPE_TIMEOUT=120
DASHSCOPE_MAX_RETRIES=3

AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://api.inferera.com/v1
AIHUBMIX_IMAGE_MODEL=gpt-image-2
AIHUBMIX_IMAGE_SIZE=1536x1024
AIHUBMIX_IMAGE_QUALITY=high
AIHUBMIX_IMAGE_TIMEOUT=300

HOST=127.0.0.1
PORT=8765
